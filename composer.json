{
  "name": "duva-mail/symfony-mailer",
  "description": "Symfony Mailer transport for Duva, the transactional email API hosted in Canada.",
  "type": "symfony-bundle",
  "license": "MIT",
  "homepage": "https://duva.ca",
  "keywords": ["duva", "symfony", "mailer", "transport", "bridge", "transactional-email", "email"],
  "require": {
    "php": ">=8.2",
    "duva-mail/duva": "^0.2",
    "guzzlehttp/guzzle": "^7.8",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
    "symfony/mime": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Duva\\Symfony\\Mailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Duva\\Symfony\\Mailer\\Tests\\": "tests/"
    }
  },
  "support": {
    "source": "https://github.com/duva-mail/duva-symfony",
    "docs": "https://duva.ca/en/docs"
  },
  "authors": [
    {
      "name": "9573-4562 Québec inc.",
      "email": "support@duva.ca"
    }
  ],
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
